---
// A Telegram-style chat mockup. The message text lives in the page, so it is
// translated with it; TgMessage/TgButtons share the global styles below.
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<figure class="tg-chat not-content" role="img" aria-label={label}>
  <slot />
</figure>

<style is:global>
  :root {
    --tg-bg: #0e1621;
    --tg-in: #182533;
    --tg-out: #2b5278;
    --tg-text: #f5f5f5;
    --tg-from: #6ab3f3;
    --tg-btn: #20303f;
    --tg-btn-text: #e4ecf2;
  }
  :root[data-theme='light'] {
    --tg-bg: #dbe5ee;
    --tg-in: #ffffff;
    --tg-out: #effdde;
    --tg-text: #000000;
    --tg-from: #3a8fd6;
    --tg-btn: #6b8fb0;
    --tg-btn-text: #ffffff;
  }
  .tg-chat {
    margin: 1.5rem 0;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--tg-bg);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 32rem;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .tg-msg {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 85%;
  }
  .tg-msg--out {
    align-self: flex-end;
    align-items: flex-end;
  }
  .tg-msg__bubble {
    background: var(--tg-in);
    color: var(--tg-text);
    padding: 0.4rem 0.7rem;
    border-radius: 0.9rem 0.9rem 0.9rem 0.25rem;
    overflow: hidden;
  }
  .tg-msg--out .tg-msg__bubble {
    background: var(--tg-out);
    border-radius: 0.9rem 0.9rem 0.25rem 0.9rem;
  }
  .tg-msg__from {
    color: var(--tg-from);
    font-weight: 600;
    font-size: 0.85em;
  }
  .tg-msg__image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0.25rem 0;
    border-radius: 0.5rem;
    image-rendering: pixelated;
  }
  .tg-msg__text :where(p) {
    margin: 0;
  }
  /* Each paragraph in a message is one line of the bot's text, with no gap, as in
     Telegram. A real blank line is written as a paragraph holding only &nbsp;. */
  .tg-msg__text :where(p + p) {
    margin-top: 0;
  }
  .tg-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.25rem;
    width: 100%;
  }
  .tg-buttons__row {
    display: flex;
    gap: 0.25rem;
  }
  .tg-buttons__btn {
    flex: 1;
    text-align: center;
    padding: 0.35rem 0.5rem;
    border-radius: 0.5rem;
    background: var(--tg-btn);
    color: var(--tg-btn-text);
    font-size: 0.85em;
  }
</style>

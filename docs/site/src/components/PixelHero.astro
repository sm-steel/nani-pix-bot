---
// Home-page banner under the splash hero's title: the sample image sharpens
// stage by stage, like a round.
import type { ImageMetadata } from 'astro';
import original from '../assets/generated/original.webp';

const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/generated/stage-*.webp', {
  eager: true,
});
const stages = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([, mod]) => mod.default);
const frames = [...stages, original];
---

<section class="pixel-hero not-content">
  <div class="pixel-hero__frames" style={`--frames: ${frames.length}`} aria-hidden="true">
    {
      frames.map((frame, index) => (
        <img src={frame.src} width={frame.width} height={frame.height} alt="" style={`--i: ${index}`} />
      ))
    }
  </div>
</section>

<style>
  .pixel-hero {
    text-align: center;
    padding-block: 0 2rem;
  }
  .pixel-hero__frames {
    position: relative;
    aspect-ratio: 1024 / 538;
    max-width: 48rem;
    margin-inline: auto;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 0 0 4px var(--sl-color-accent);
  }
  .pixel-hero__frames img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
    opacity: 0;
    animation: pixel-hero-step calc(var(--frames) * 1.2s) step-end infinite;
    animation-delay: calc(var(--i) * 1.2s);
  }
  @keyframes pixel-hero-step {
    0% {
      opacity: 1;
    }
    16.67% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pixel-hero__frames img {
      animation: none;
    }
    .pixel-hero__frames img:last-child {
      opacity: 1;
    }
  }
</style>

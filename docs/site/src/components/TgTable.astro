---
// A table inside a bot message, drawn the way Telegram renders the bot's
// markdown tables: an optional heading, then a rounded, fully bordered
// grid with a tinted header row. Cells starting with @ read as mentions.
interface Props {
  heading?: string;
  columns: string[];
  rows: (string | number)[][];
}

const { heading, columns, rows } = Astro.props;
const isMention = (cell: string | number) => typeof cell === 'string' && cell.startsWith('@');
---

{heading && <strong class="tg-table__heading">{heading}</strong>}
<div class="tg-table">
  <table>
    <thead>
      <tr>{columns.map((column) => <th>{column}</th>)}</tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell) => (
              <td class:list={{ 'tg-table__mention': isMention(cell) }}>{cell}</td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .tg-table__heading {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 1.35em;
  }
  .tg-table {
    --tg-table-line: color-mix(in oklab, currentColor 18%, transparent);
    border: 1px solid var(--tg-table-line);
    border-radius: 0.5rem;
    overflow: hidden;
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: 0.45rem 0.7rem;
    border-right: 1px solid var(--tg-table-line);
    border-bottom: 1px solid var(--tg-table-line);
    text-align: start;
    white-space: nowrap;
  }
  :is(th, td):last-child {
    border-right: 0;
  }
  tbody tr:last-child td {
    border-bottom: 0;
  }
  th {
    background: color-mix(in oklab, currentColor 7%, transparent);
    font-weight: 600;
    text-align: center;
  }
  .tg-table__mention {
    color: var(--tg-from);
  }
</style>

---
// The five generated stages side by side, each with the wrong guesses it
// allows by default, shown as a close-up (from stages.json, written by gen_docs_stages.py).
import type { ImageMetadata } from 'astro';
import stages from '../assets/generated/stages.json';

interface Props {
  caption: string;
}

const { caption } = Astro.props;
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/generated/stage-*.webp', {
  eager: true,
});
const images = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([, mod]) => mod.default);
---

<figure class="stage-strip">
  <div class="stage-strip__row">
    {
      stages.map((stage, index) => (
        <div class="stage-strip__tile">
          <span class="stage-strip__crop" style={`background-image: url(${images[index].src})`} />
          <span class="stage-strip__stage">{stage.stage}/{stages.length}</span>
          <span class="stage-strip__limit">❌ ×{stage.wrongGuessLimit}</span>
        </div>
      ))
    }
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .stage-strip {
    margin: 0;
  }
  .stage-strip__row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  .stage-strip__tile {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    font-family: var(--guide-font-display);
  }
  /* A close-up of the same spot on every stage, so the blockiness shows even
     at thumbnail size. */
  .stage-strip__crop {
    width: 100%;
    aspect-ratio: 1;
    background-size: 380% auto;
    background-position: 74% 42%;
    image-rendering: pixelated;
    border-radius: 0.25rem;
    box-shadow: 0 0 0 2px var(--sl-color-accent);
  }
  .stage-strip__stage {
    color: var(--sl-color-white);
  }
  .stage-strip__limit {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  figcaption {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>

# Copy to .env and fill in. Never commit the real .env.
# This file is used both by docker-compose (variable substitution + the
# bot container's env) and by the mariadb container (DB bootstrap vars).

# Telegram
BOT_TOKEN=
# The group chat's id and the id of the one topic within it the bot is
# active in. Game setup (photo or /newgame + identification) happens in DM
# instead, so GAME_TOPIC_ID alone would be meaningless without GROUP_CHAT_ID
# too.
GROUP_CHAT_ID=
GAME_TOPIC_ID=
ADMIN_USER_IDS=

# Optional. DEBUG/INFO/WARNING/ERROR — see CLAUDE.md's Logging section.
# Defaults to INFO if unset.
LOG_LEVEL=INFO

# Optional. Set this if your host can't reach Telegram's API directly
# (e.g. it's geo-blocked or firewalled) — routes getUpdates + send* calls
# through an HTTP proxy instead.
TELEGRAM_PROXY_URL=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT

# TMDB API Read Access Token (v4 bearer-token auth — Settings > API on
# themoviedb.org, "API Read Access Token", not the older v3 "API Key").
# Optional — without it, everything except the TMDB identification/
# screenshot method still works. If TMDB is unreachable from your host,
# services/search/tmdb.py reuses TELEGRAM_PROXY_URL above.
TMDB_READ_ACCESS_TOKEN=

# Database — the bot connects to the "mariadb" service by its compose
# network hostname, not localhost.
DATABASE_URL=mysql+pymysql://nani_pix_bot:PASSWORD@mariadb:3306/nani_pix_bot

# MariaDB container bootstrap (must match the credentials embedded in
# DATABASE_URL above).
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATABASE=nani_pix_bot
MARIADB_USER=nani_pix_bot
MARIADB_PASSWORD=PASSWORD

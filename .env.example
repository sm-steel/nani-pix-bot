# Copy to .env and fill in. Never commit the real .env.
# This file is used both by docker-compose (variable substitution + the
# bot container's env) and by the mariadb container (DB bootstrap vars).

# Telegram
BOT_TOKEN=
# The group chat's id and the id of the one topic within it the bot is
# active in. Game setup (photo or /newgame + identification) happens in DM
# instead, so GAME_TOPIC_ID alone would be meaningless without GROUP_CHAT_ID
# too.
GROUP_CHAT_ID=
GAME_TOPIC_ID=
ADMIN_USER_IDS=

# Optional. DEBUG/INFO/WARNING/ERROR — see CLAUDE.md's Logging section.
# Defaults to INFO if unset.
LOG_LEVEL=INFO

# Optional. Set this if your host can't reach Telegram's API directly
# (e.g. it's geo-blocked or firewalled) — routes getUpdates + send* calls
# through an HTTP proxy instead.
TELEGRAM_PROXY_URL=http://USERNAME:PASSWORD@PROXY_HOST:PROXY_PORT

# TMDB API Read Access Token (v4 bearer-token auth — Settings > API on
# themoviedb.org, "API Read Access Token", not the older v3 "API Key").
# Optional — without it, everything except the TMDB identification/
# screenshot method still works. If TMDB or Tenrai is unreachable from
# your host, services/search/tmdb.py and services/search/tenrai.py both
# reuse TELEGRAM_PROXY_URL above.
TMDB_READ_ACCESS_TOKEN=

# Optional — enables the "My MAL list" identification method (a player
# links their own MyAnimeList account and picks from anime they've
# watched). All four of these must be set together, or the method
# simply never appears (same as TMDB above).
#
# MAL_CLIENT_ID / MAL_CLIENT_SECRET: register a free app at
# https://myanimelist.net/apiconfig — Authorization Code Grant with
# PKCE, App Type "web".
#
# MAL_REDIRECT_URI: must exactly match the redirect URI registered
# with your MAL app. See docs/mal-callback.html — this repo's own
# static callback page, meant to be served via this repo's GitHub
# Pages (enable it in your fork's Settings -> Pages, source: branch
# `master`, folder `/docs`), e.g.
# https://<your-github-username>.github.io/nani-pix-bot/mal-callback.html
#
# MAL_TOKEN_ENCRYPTION_KEY: a Fernet key encrypting stored player
# tokens at rest. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret — anyone with it and DB access can decrypt every
# linked player's MAL tokens. Losing/rotating it just means every
# existing link stops decrypting (players are prompted to /linkmal
# again), not a crash.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=
MAL_TOKEN_ENCRYPTION_KEY=

# Database — the bot connects to the "mariadb" service by its compose
# network hostname, not localhost.
DATABASE_URL=mysql+pymysql://nani_pix_bot:PASSWORD@mariadb:3306/nani_pix_bot

# MariaDB container bootstrap (must match the credentials embedded in
# DATABASE_URL above).
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATABASE=nani_pix_bot
MARIADB_USER=nani_pix_bot
MARIADB_PASSWORD=PASSWORD
